{
  "name": "riway-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:new": "supabase migration new",
    "test:http": "node tests/integration/http.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "setup:providers": "node scripts/setup-providers.mjs",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@clerk/nextjs": "7.9.24",
    "@opennextjs/cloudflare": "1.20.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "split-type": "^0.3.4",
    "stripe": "23.1.0",
    "three": "0.170.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "supabase": "2.81.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "tar": "^7.5.21",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  }
